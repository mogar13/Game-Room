{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && (data.child('uid').val() === auth.uid || (!data.exists() && newData.child('uid').val() === auth.uid) || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['uid'])"
      }
    },

    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "!newData.exists() || newData.hasChildren(['name'])",
        "name":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "avatar":   { ".validate": "newData.isString() && newData.val().length <= 8" },
        "bankroll": { ".validate": "newData.isNumber()" },
        "xp":       { ".validate": "newData.isNumber()" },
        "level":    { ".validate": "newData.isNumber()" },
        "wins":     { ".validate": "newData.isNumber()" },
        "$other":   { ".validate": false }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "chat": {
      ".read": true,
      "$roomId": {
        ".write": true,
        "messages": {
          "$msgId": {
            "text":   { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "$other": { ".validate": true }
          }
        }
      }
    },

    "global_chat": {
      ".read": true,
      ".write": true,
      "$msgId": {
        "text":   { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "$other": { ".validate": true }
      }
    },

    "bug_reports": {
      ".read": false,
      ".write": true
    },

    "$room": {
      ".read": "$room.matches(/(_rooms|_hands|_hand_incoming)$/)",
      ".write": "$room.matches(/(_rooms|_hands|_hand_incoming)$/)"
    }
  }
}
